# LightRAG 使用 Gemini API（见 Google AI Studio 获取 Key）
GEMINI_API_KEY=your-gemini-api-key
# 可选，默认如下
# LIGHTRAG_LLM_MODEL=gemini-2.0-flash
# LIGHTRAG_EMBED_MODEL=gemini-embedding-001

# Neo4j（知识图谱存储，需先启动 Neo4j）
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
